#include<stdio.h>

int main()
{
    int cost[4][4]={
        {0,2,4,0},
        {2,0,1,7},
        {4,1,0,3},
        {0,7,3,0}
    };

    int dist[4]={0,999,999,999};
    int visited[4]={0};

    for(int k=0;k<4;k++)
    {
        int min=999,u;

        for(int i=0;i<4;i++)
            if(!visited[i] && dist[i]<min)
            {
                min=dist[i];
                u=i;
            }

        visited[u]=1;

        for(int v=0;v<4;v++)
            if(cost[u][v] && dist[u]+cost[u][v]<dist[v])
                dist[v]=dist[u]+cost[u][v];
    }

    for(int i=0;i<4;i++)
        printf("%d ",dist[i]);
}
