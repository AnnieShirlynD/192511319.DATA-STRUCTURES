#include<stdio.h>

int parent[10];

int find(int i)
{
    while(parent[i])
        i=parent[i];
    return i;
}

void uni(int i,int j)
{
    parent[j]=i;
}

int main()
{
    int cost[3][3]={
        {999,2,3},
        {2,999,1},
        {3,1,999}
    };

    int min,a,b,u,v;

    for(int e=0;e<2;e++)
    {
        min=999;

        for(int i=0;i<3;i++)
            for(int j=0;j<3;j++)
                if(cost[i][j]<min)
                {
                    min=cost[i][j];
                    a=u=i;
                    b=v=j;
                }

        u=find(u);
        v=find(v);

        if(u!=v)
        {
            printf("%d-%d\n",a,b);
            uni(u,v);
        }

        cost[a][b]=cost[b][a]=999;
    }
}
