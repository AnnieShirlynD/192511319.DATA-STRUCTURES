#include<stdio.h>

int q[10], n=0;

void insert(int x)
{
    int i=n-1;
    while(i>=0 && q[i]<x)
    {
        q[i+1]=q[i];
        i--;
    }
    q[i+1]=x;
    n++;
}

void delete()
{
    printf("Deleted=%d\n",q[0]);
    for(int i=0;i<n-1;i++)
        q[i]=q[i+1];
    n--;
}

int main()
{
    insert(20);
    insert(50);
    insert(30);

    delete();
}
