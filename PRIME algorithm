#include<stdio.h>

int main()
{
    int cost[3][3]={
        {0,2,3},
        {2,0,1},
        {3,1,0}
    };

    int selected[3]={1,0,0};
    int edge=0,min,x,y;

    while(edge<2)
    {
        min=999;

        for(int i=0;i<3;i++)
        {
            if(selected[i])
            {
                for(int j=0;j<3;j++)
                {
                    if(!selected[j] && cost[i][j])
                    {
                        if(cost[i][j]<min)
                        {
                            min=cost[i][j];
                            x=i;
                            y=j;
                        }
                    }
                }
            }
        }

        printf("%d-%d\n",x,y);
        selected[y]=1;
        edge++;
    }
}
